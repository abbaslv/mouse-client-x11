<Window x:Class="X11Mouse.App.Views.SelectMacroWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        AllowsTransparency="True" Background="Transparent" SizeToContent="WidthAndHeight">
    <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderSubtleBrush}"
            BorderThickness="1" CornerRadius="8" Width="430" Padding="20">
        <StackPanel>
            <TextBlock Text="Assign Macro to Button" Foreground="{StaticResource TextPrimaryBrush}"
                       FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12" />

            <TextBlock Text="Macro List" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,6" />
            <ListBox x:Name="MacroList" Height="160" Background="{StaticResource DeepBgBrush}"
                     Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderSubtleBrush}"
                     DisplayMemberPath="Name" Margin="0,0,0,14" />

            <TextBlock Text="Cycle Mode" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,8" />
            <StackPanel Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <RadioButton x:Name="CycleLoopRadio" Content="Loop Times:" Style="{StaticResource DarkRadioStyle}"
                                 GroupName="Cycle" IsChecked="True" Checked="CycleChanged" />
                    <TextBox x:Name="RepeatBox" Style="{StaticResource DarkTextBoxStyle}" Width="64" Height="26"
                             Margin="10,0,0,0" Text="1" />
                    <TextBlock Text="(1 - 255)" Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                               VerticalAlignment="Center" Margin="8,0,0,0" />
                </StackPanel>
                <RadioButton x:Name="CycleAnyKeyRadio" Content="Any Key Press To Stop Playing" Style="{StaticResource DarkRadioStyle}"
                             GroupName="Cycle" Margin="0,0,0,8" Checked="CycleChanged" />
                <RadioButton x:Name="CycleHoldRadio" Content="Press And Hold, Release To Stop" Style="{StaticResource DarkRadioStyle}"
                             GroupName="Cycle" Checked="CycleChanged" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource DarkButtonStyle}" MinWidth="82" Margin="0,0,10,0" Click="Cancel_Click" />
                <Button Content="Assign" Style="{StaticResource PrimaryAccentButtonStyle}" MinWidth="82" Click="Ok_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
