<Window x:Class="X11Mouse.App.Views.MacroManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        AllowsTransparency="True" Background="Transparent" Width="760" Height="530">
    <Border Background="{StaticResource AppBgBrush}" BorderBrush="{StaticResource BorderSubtleBrush}"
            BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="54" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Background="{StaticResource DeepBgBrush}" CornerRadius="8,8,0,0"
                    MouseLeftButtonDown="TitleBar_MouseDown" Padding="16,0">
                <Grid>
                    <TextBlock Text="Macro Editor" Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="14.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Content="✕" Style="{StaticResource WindowChromeButtonStyle}"
                            HorizontalAlignment="Right" Click="Close_Click" />
                </Grid>
            </Border>

            <!-- Content -->
            <Grid Grid.Row="1" Margin="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="225" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left: Macro List -->
                <Border Grid.Column="0" Style="{StaticResource CardPanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Macro List" Foreground="{StaticResource TextPrimaryBrush}"
                                   FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8" />
                        <ListBox Grid.Row="1" x:Name="MacroListBox" Background="{StaticResource DeepBgBrush}"
                                 Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderSubtleBrush}"
                                 DisplayMemberPath="Name" SelectionChanged="MacroListBox_SelectionChanged" />
                        <UniformGrid Grid.Row="2" Rows="1" Columns="3" Margin="0,8,0,0">
                            <Button Content="+ New" Style="{StaticResource DarkButtonStyle}" Margin="0,0,4,0" Click="NewMacro_Click" />
                            <Button Content="Rename" Style="{StaticResource DarkButtonStyle}" Margin="2,0" Click="RenameMacro_Click" />
                            <Button Content="Delete" Style="{StaticResource DarkButtonStyle}" Margin="4,0,0,0" Click="DeleteMacro_Click" />
                        </UniformGrid>
                        <UniformGrid Grid.Row="3" Rows="1" Columns="2" Margin="0,6,0,0">
                            <Button Content="Import .macro" Style="{StaticResource DarkButtonStyle}" Margin="0,0,3,0" Click="ImportMacro_Click" />
                            <Button Content="Export .macro" Style="{StaticResource DarkButtonStyle}" Margin="3,0,0,0" Click="ExportMacro_Click" />
                        </UniformGrid>
                    </Grid>
                </Border>

                <!-- Right: Actions & Recording -->
                <Border Grid.Column="2" Style="{StaticResource CardPanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Margin="0,0,0,8">
                            <TextBlock x:Name="ActionCountText" Text="Actions (0 / 46)" Foreground="{StaticResource TextPrimaryBrush}"
                                       FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="+ LMB" Style="{StaticResource DarkButtonStyle}" Margin="0,0,4,0" Padding="8,4" Click="InsertMouseLeft_Click" />
                                <Button Content="+ RMB" Style="{StaticResource DarkButtonStyle}" Margin="0,0,4,0" Padding="8,4" Click="InsertMouseRight_Click" />
                                <Button Content="↑" Style="{StaticResource DarkButtonStyle}" Margin="0,0,4,0" Padding="8,4" Click="MoveUp_Click" />
                                <Button Content="↓" Style="{StaticResource DarkButtonStyle}" Margin="0,0,4,0" Padding="8,4" Click="MoveDown_Click" />
                                <Button Content="Del" Style="{StaticResource DarkButtonStyle}" Margin="0,0,4,0" Padding="8,4" Click="DeleteAction_Click" />
                                <Button Content="Clear" Style="{StaticResource DarkButtonStyle}" Padding="8,4" Click="ClearActions_Click" />
                            </StackPanel>
                        </Grid>

                        <ListView Grid.Row="1" x:Name="ActionListView" Background="{StaticResource DeepBgBrush}"
                                  Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderSubtleBrush}"
                                  SelectionMode="Single">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="#" Width="38" DisplayMemberBinding="{Binding Index}" />
                                    <GridViewColumn Header="Input / Key" Width="170" DisplayMemberBinding="{Binding KeyName}" />
                                    <GridViewColumn Header="State" Width="85" DisplayMemberBinding="{Binding StateName}" />
                                    <GridViewColumn Header="Delay (ms)" Width="95" DisplayMemberBinding="{Binding DelayMs}" />
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <!-- Edit selected action delay -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Delay Options:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <RadioButton x:Name="RecordDelayRadio" Content="Record Delay" Style="{StaticResource DarkRadioStyle}"
                                         GroupName="DelayMode" IsChecked="True" Margin="0,0,12,0" Checked="DelayMode_Changed" />
                            <RadioButton x:Name="DefaultDelayRadio" Content="Default:" Style="{StaticResource DarkRadioStyle}"
                                         GroupName="DelayMode" Margin="0,0,6,0" Checked="DelayMode_Changed" />
                            <TextBox x:Name="DefaultDelayBox" Style="{StaticResource DarkTextBoxStyle}" Width="50" Height="24"
                                     Text="50" Margin="0,0,12,0" />
                            <RadioButton x:Name="NoDelayRadio" Content="Min (10ms)" Style="{StaticResource DarkRadioStyle}"
                                         GroupName="DelayMode" Checked="DelayMode_Changed" />
                        </StackPanel>

                        <Grid Grid.Row="3" Margin="0,10,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Selected Delay (ms):" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox x:Name="EditDelayBox" Style="{StaticResource DarkTextBoxStyle}" Width="66" Height="26" Text="50" />
                                <Button Content="Update Delay" Style="{StaticResource DarkButtonStyle}" Margin="6,0,0,0" Padding="10,4" Click="UpdateSelectedDelay_Click" />
                            </StackPanel>
                            <Button x:Name="RecordButton" Content="● Start Record" Style="{StaticResource PrimaryAccentButtonStyle}"
                                    HorizontalAlignment="Right" MinWidth="138" Height="32" Click="RecordButton_Click" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Footer -->
            <Border Grid.Row="2" Background="{StaticResource DeepBgBrush}" CornerRadius="0,0,8,8" Padding="16,0">
                <Grid>
                    <TextBlock x:Name="StatusText" Text="Select or record up to 46 actions per macro."
                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" FontSize="12" />
                    <Button Content="Save &amp; Close" Style="{StaticResource PrimaryAccentButtonStyle}"
                            HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="110" Height="32" Click="Close_Click" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
