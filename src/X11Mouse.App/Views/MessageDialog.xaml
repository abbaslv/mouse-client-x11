<Window x:Class="X11Mouse.App.Views.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        AllowsTransparency="True" Background="Transparent" SizeToContent="WidthAndHeight">
    <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderSubtleBrush}"
            BorderThickness="1" CornerRadius="8" Width="380" Padding="20">
        <StackPanel>
            <TextBlock x:Name="TitleText" Text="Notice" Foreground="{StaticResource TextPrimaryBrush}"
                       FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
            <TextBlock x:Name="BodyText" Text="Message" Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="13" TextWrapping="Wrap" Margin="0,0,0,20" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelBtn" Content="Cancel" Style="{StaticResource DarkButtonStyle}"
                        MinWidth="82" Margin="0,0,10,0" Click="CancelBtn_Click" />
                <Button x:Name="OkBtn" Content="OK" Style="{StaticResource PrimaryAccentButtonStyle}"
                        MinWidth="82" Click="OkBtn_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
