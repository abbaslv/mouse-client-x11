<Window x:Class="X11Mouse.App.Views.DpiOsdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False"
        ShowActivated="False" AllowsTransparency="True" Background="Transparent"
        SizeToContent="WidthAndHeight">
    <Border Background="#EE121212" BorderBrush="{StaticResource BorderSubtleBrush}"
            BorderThickness="1.2" CornerRadius="8" Padding="16,10" MinWidth="185">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse x:Name="StageDot" Width="12" Height="12" Fill="#E2211C" Margin="0,0,10,0" />
            <StackPanel>
                <TextBlock Text="ACTIVE DPI" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" FontWeight="SemiBold" />
                <TextBlock x:Name="DpiLabel" Text="1600 DPI" Foreground="{StaticResource TextPrimaryBrush}" FontSize="16" FontWeight="Bold" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
