<Window x:Class="X11Mouse.App.Views.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        AllowsTransparency="True" Background="Transparent" SizeToContent="WidthAndHeight">
    <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderSubtleBrush}"
            BorderThickness="1" CornerRadius="8" Width="390" Padding="18">
        <StackPanel>
            <Grid Margin="0,0,0,12">
                <TextBlock Text="Select Color" Foreground="{StaticResource TextPrimaryBrush}" FontSize="15" FontWeight="SemiBold" />
                <Border x:Name="PreviewSwatch" Width="46" Height="22" CornerRadius="4" HorizontalAlignment="Right"
                        BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" />
            </Grid>

            <!-- Preset swatches matching official DPI palette -->
            <UniformGrid Rows="1" Columns="8" Margin="0,0,0,14" x:Name="PresetGrid" />

            <!-- Hue bar -->
            <TextBlock Text="Hue" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" Margin="0,0,0,4" />
            <Grid Margin="0,0,0,10">
                <Border Height="10" CornerRadius="5" VerticalAlignment="Center">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FF0000" Offset="0.00" />
                            <GradientStop Color="#FFFF00" Offset="0.17" />
                            <GradientStop Color="#00FF00" Offset="0.33" />
                            <GradientStop Color="#00FFFF" Offset="0.50" />
                            <GradientStop Color="#0000FF" Offset="0.67" />
                            <GradientStop Color="#FF00FF" Offset="0.83" />
                            <GradientStop Color="#FF0000" Offset="1.00" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Slider x:Name="HueSlider" Minimum="0" Maximum="359" ValueChanged="HueSlider_ValueChanged" Background="Transparent" />
            </Grid>

            <!-- R / G / B sliders -->
            <Grid Margin="0,2,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="42" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="28" />
                    <RowDefinition Height="28" />
                    <RowDefinition Height="28" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="R" Foreground="#FF6B6B" VerticalAlignment="Center" FontWeight="SemiBold" />
                <Slider Grid.Row="0" Grid.Column="1" x:Name="RSlider" Minimum="0" Maximum="255" Style="{StaticResource DarkSliderStyle}" ValueChanged="RgbSlider_ValueChanged" />
                <TextBlock Grid.Row="0" Grid.Column="2" x:Name="RValText" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="G" Foreground="#6BFF8E" VerticalAlignment="Center" FontWeight="SemiBold" />
                <Slider Grid.Row="1" Grid.Column="1" x:Name="GSlider" Minimum="0" Maximum="255" Style="{StaticResource DarkSliderStyle}" ValueChanged="RgbSlider_ValueChanged" />
                <TextBlock Grid.Row="1" Grid.Column="2" x:Name="GValText" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="B" Foreground="#6BAEFF" VerticalAlignment="Center" FontWeight="SemiBold" />
                <Slider Grid.Row="2" Grid.Column="1" x:Name="BSlider" Minimum="0" Maximum="255" Style="{StaticResource DarkSliderStyle}" ValueChanged="RgbSlider_ValueChanged" />
                <TextBlock Grid.Row="2" Grid.Column="2" x:Name="BValText" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>

            <Grid Margin="0,10,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="45" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="HEX" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" x:Name="HexBox" Style="{StaticResource DarkTextBoxStyle}" Height="30"
                         FontFamily="Consolas" TextChanged="HexBox_TextChanged" />
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource DarkButtonStyle}" MinWidth="82" Margin="0,0,10,0" Click="Cancel_Click" />
                <Button Content="Apply" Style="{StaticResource PrimaryAccentButtonStyle}" MinWidth="82" Click="Ok_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
